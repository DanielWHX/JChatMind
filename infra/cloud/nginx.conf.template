# Browser Basic Auth protects the original application. Only the explicitly
# listed guest endpoints are public; the upstream admin secret never enters JS.
map "$http_origin|$http_host" $admin_origin_allowed {
    default 0;
    "~^\\|" 1;
    "~*^https?://([^/]+)\\|\\1$" 1;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 3m;
    auth_basic "JChatMind administration";
    auth_basic_user_file /etc/nginx/private/admin.htpasswd;

    add_header Content-Security-Policy "frame-ancestors 'self' ${PORTFOLIO_ORIGIN}" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /health {
        auth_basic off;
        access_log off;
        proxy_set_header X-JChatMind-Admin "";
        proxy_pass http://api:8080/health;
    }

    location = /demo {
        auth_basic off;
        try_files /index.html =404;
    }

    location = /demo/ {
        auth_basic off;
        return 308 /demo;
    }

    location = /api/demo/sessions {
        auth_basic off;
        include /etc/nginx/snippets/guest-proxy.conf;
    }

    location = /api/demo/session {
        auth_basic off;
        include /etc/nginx/snippets/guest-proxy.conf;
    }

    location = /api/demo/messages {
        auth_basic off;
        include /etc/nginx/snippets/guest-proxy.conf;
    }

    location ^~ /api/ {
        if ($admin_origin_allowed = 0) { return 403; }
        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_set_header X-JChatMind-Admin "${JCHATMIND_ADMIN_SECRET}";
        proxy_set_header Authorization "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        add_header X-Accel-Buffering no always;
    }

    location ^~ /sse/ {
        if ($admin_origin_allowed = 0) { return 403; }
        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-JChatMind-Admin "${JCHATMIND_ADMIN_SECRET}";
        proxy_set_header Authorization "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 180s;
        add_header X-Accel-Buffering no always;
    }

    location /assets/ {
        auth_basic off;
        try_files $uri =404;
        expires 7d;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
